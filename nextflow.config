profiles {

    apptainer {

        apptainer.enabled = true
        //apptainer.runOptions = "--bind ${projectDir}/test"
        process  {
            container = 'docker://dockerbrc/python_etl_packages:v1.2'
        
            withLabel: cnv_calling {
                container = 'docker://flobenhsj/quantisnp_penncnv:v2.3'

            }
            
            withName: generate_hmm {

                container = 'docker://flobenhsj/quantisnp_penncnv:v2.3'
            } 

            withName: generate_pfb {
                container = 'docker://dockerbrc/python_etl_packages:v1.2'
    
                }

            withName: denovo_cnv_annotation_type {
                container = 'docker://dockerbrc/python_etl_packages:v1.2'

            }

            withLabel: Rmarkdown {
                container = 'docker://flobenhsj/cnv_caller_report:latest'

            }
        }
    }

    local {
        executor.name = 'local'
        executor.cpus = 6
        executor.memory = '14G'
            process {
                withName: generate_pfb {
                memory = '14G'
                }
            }
        
        params {
             plink2samplemetadata_tsv = "${projectDir}/test/metadata.tsv"
             list_sample_baflrrpath = "${projectDir}/test/samplefile.tsv"
             batch_size = 3
             genome_version = "GRCh38"
             dataset_name = "test"
             report = false
             pfb_max_sample_size = 3
        }

    }
}
