

apptainer {
    enabled = true
}

process {

    executor = 'local'
    container = '/lustre09/project/6008022/LAB_WORKSPACE/SOFTWARE/Dockers/python_etl_packages_latest.sif'

    withLabel: penncnv_quantisnp {
        container = '/lustre09/project/6008022/LAB_WORKSPACE/SOFTWARE/Dockers/quantisnp_penncnv_v2.3.sif'
    }

    withLabel: Rmarkdown {
        container = '/lustre09/project/6008022/LAB_WORKSPACE/SOFTWARE/Dockers/cnv_caller_report_latest.sif'
    }

    withName: callBatchCNVs {
        executor = 'slurm'
        clusterOptions = '--account=rrg-jacquese --mem-per-cpu=3500MB'
        time = '2h'
        cpus = 192
    }

    withName: generate_hmm {
        executor = 'slurm'
        clusterOptions = '--account=rrg-jacquese --mem-per-cpu=3500MB'
        time = '30m'
        cpus = 8
    }

    withName: generate_pfb {
        executor = 'slurm'
        clusterOptions = '--account=rrg-jacquese'
        time = "1h"
        cpus = 64
        memory = '250G'
    }
}
