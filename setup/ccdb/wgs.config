
executor.queueSize = 10
process {
    executor = 'local'
    module = ['bedtools/2.31.0']
   

    withLabel: cnv_calling {
        executor = 'slurm'
        clusterOptions = '--account=rrg-jacquese'
        time = { 2.hour * task.attempt }
        memory = '750G'
        cpus = 192
        module = ['apptainer/1.3.5']
        // Using docker://flobenhsj/quantisnp_penncnv:v2.2
        container = "/lustre09/project/6008022/LAB_WORKSPACE/SOFTWARE/Dockers/quantisnp_penncnv_v2.3.sif" 
        maxRetries = { task.exitStatus == 140 ? 4 : 1 }
        maxForks = 5
        }

    withName: generate_pfb {
        executor = 'slurm'
        module = ['apptainer/1.3.5']
        time = { 1.hour * task.attempt }
        clusterOptions = '--account=rrg-jacquese'
        container = "/lustre09/project/6008022/LAB_WORKSPACE/SOFTWARE/Dockers/compile_pfb.sif"
        cpus = 192
        memory = '750G'
        maxRetries = { task.exitStatus == 140 ? 4 : 1 }
        }
    withName: denovo_cnv_annotation_type {
        module = ['apptainer/1.3.5']
        container = "/lustre09/project/6008022/LAB_WORKSPACE/SOFTWARE/Dockers/duckdb_python_v1.2.sif"
    }
    withLabel: Rmarkdown {
        container = "/lustre09/project/6008022/LAB_WORKSPACE/SOFTWARE/Dockers/CNV-caller_report.sif"
        module = ['apptainer/1.3.5']
    
    }
}
apptainer {
    enabled = true
    autoMounts = true
    runOptions = '--bind /home,/project,/scratch,/lustre09'
}
