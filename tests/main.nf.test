
//to launch the test on local :
// nf-test test tests/main.nf.test --profile apptainer,local
nextflow_pipeline {

    name "T1:Test Full Pipeline Workflow main.nf without report"
    script "main.nf"

    test("Should run without failures and produce final outputs") {

        when {
            params {
             plink2samplemetadata_tsv = "${projectDir}/tests/metadata.tsv"
             list_sample_baflrrpath = "${projectDir}/tests/samplefile.tsv"
             batch_size = 3
             genome_version = "GRCh38"
             dataset_name = "T1"
             report = false
             pfb_max_sample_size = 3
             outDir = "results/tests"
            }
        }

        then {
            assert workflow.success
            assert file("$launchDir/results/T1/CNV_merged_dataset.tsv").exists()
            assert file("$launchDir/results/T1/sampleDB.tsv").exists()
            assert file("$launchDir/results/T1/docs/launch_report.txt").exists()
            assert file("$launchDir/results/T1/calls_unfiltered/penncnv/PennCNV_CNV.tsv").exists()
            assert file("$launchDir/results/T1/calls_unfiltered/penncnv/PennCNV_QC.tsv").exists()
            assert file("$launchDir/results/T1/calls_unfiltered/penncnv/PennCNV_raw_calls.txt").exists()
            assert file("$launchDir/results/T1/calls_unfiltered/quantisnp/QuantiSNP_CNV.tsv").exists()
            assert file("$launchDir/results/T1/calls_unfiltered/quantisnp/QuantiSNP_raw_calls.txt").exists()
        }

    }


